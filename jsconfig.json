{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["google-apps-script", "google-apps-script/apis/drive_v3"],
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": [
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "build_preview.cjs"
  ]
}
